enum TipoRol {
  PROFESIONAL_ROL
  USER_ROL
}

model Role {
  id          Int     @id @default(autoincrement())
  description TipoRol @unique
  users       User[]

  @@map("role")
}

model User {
  id                   String   @id @default(uuid())
  email                String   @unique
  name                 String
  emailVerified        Boolean  @default(false)
  password             String
  roleId               Int
  role                 Role     @relation(fields: [roleId], references: [id])
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  resetToken           String?
  resetTokenExpiration DateTime?

  testsBreveEstadoDeAnimo TestBreveEstadoDeAnimo[]
  registrosEstadoAnimo RegistroEstadoAnimo[]

  @@map("user")
  
}