model GrupoEmociones1 {
  id          Int     @id @default(autoincrement())
  triste      Boolean @default(false)
  melancolico Boolean @default(false)
  deprimido   Boolean @default(false)
  decaido     Boolean @default(false)
  infeliz     Boolean @default(false)

  porcentajeCreenciaAntes   Int
  porcentajeCreenciaDespues Int?

  registroEstadoAnimo RegistroEstadoAnimo?

  @@map("grupoEmociones1")
}

