model GrupoEmocionesPersonalizadas {
  id                          Int                    @id @default(autoincrement())
  emociones                   EmocionPersonalizada[]
  porcentajeCreenciaAntes     Int
  porcentajeCreenciaDespues   Int?

  registroEstadoAnimo RegistroEstadoAnimo?

  @@map("grupoEmocionesPersonalizadas")
}

model EmocionPersonalizada {
  id                             Int                          @id @default(autoincrement())
  descripcion                    String
  grupoEmocionesPersonalizadasId Int
  grupoEmocionesPersonalizadas   GrupoEmocionesPersonalizadas @relation(fields: [grupoEmocionesPersonalizadasId], references: [id])

  @@map("emocionPersonalizada")
}

model Distorsion {
  id                             Int          @id @default(autoincrement())
  pensamientoTodoONada           Boolean      @default(false)
  generalizacionExcesiva         Boolean      @default(false)
  filtroMental                   Boolean      @default(false)
  descargarLoPositivo            Boolean      @default(false)
  saltarAConclusiones            Boolean      @default(false)
  magnificacionOMinimizacion     Boolean      @default(false)
  razonamientoEmocional          Boolean      @default(false)
  afirmacionesDelTipoDeberia     Boolean      @default(false)
  ponerEtiquetas                 Boolean      @default(false)
  inculpacion                    Boolean      @default(false)
  pensamiento                    Pensamiento?

  @@map("distorsion")
}

model Pensamiento {
  id Int @id @default(autoincrement())

  pensamientoNegativo       String
  porcentajeCreenciaAntes   Int
  porcentajeCreenciaDespues Int?

  pensamientoPositivo        String
  porcentajeCreenciaPositivo Int?

  distorsion   Distorsion @relation(fields: [distorsionId], references: [id])
  distorsionId Int        @unique

  registroEstadoAnimoId String
  registroEstadoAnimo  RegistroEstadoAnimo   @relation(fields: [registroEstadoAnimoId], references: [id])


  @@map("pensamiento")
}

model RegistroEstadoAnimo {
  id                  String   @id @default(uuid())
  idUsuario           String
  user                User     @relation(fields: [idUsuario], references: [id])
  fecha               DateTime @default(now())
  sucesoTrastornador  String

  grupoEmociones1   GrupoEmociones1? @relation(fields: [grupoEmociones1Id], references: [id])
  grupoEmociones1Id Int?             @unique

  grupoEmociones2   GrupoEmociones2? @relation(fields: [grupoEmociones2Id], references: [id])
  grupoEmociones2Id Int?             @unique

  grupoEmociones3   GrupoEmociones3? @relation(fields: [grupoEmociones3Id], references: [id])
  grupoEmociones3Id Int?             @unique

  grupoEmociones4   GrupoEmociones4? @relation(fields: [grupoEmociones4Id], references: [id])
  grupoEmociones4Id Int?             @unique

  grupoEmociones5   GrupoEmociones5? @relation(fields: [grupoEmociones5Id], references: [id])
  grupoEmociones5Id Int?             @unique

  grupoEmociones6   GrupoEmociones6? @relation(fields: [grupoEmociones6Id], references: [id])
  grupoEmociones6Id Int?             @unique

  grupoEmociones7   GrupoEmociones7? @relation(fields: [grupoEmociones7Id], references: [id])
  grupoEmociones7Id Int?             @unique

  grupoEmociones8   GrupoEmociones8? @relation(fields: [grupoEmociones8Id], references: [id])
  grupoEmociones8Id Int?             @unique

  grupoEmociones9   GrupoEmociones9? @relation(fields: [grupoEmociones9Id], references: [id])
  grupoEmociones9Id Int?             @unique

  grupoEmocionesPersonalizadas   GrupoEmocionesPersonalizadas? @relation(fields: [grupoEmocionesPersonalizadasId], references: [id])
  grupoEmocionesPersonalizadasId Int?                          @unique

  pensamientos Pensamiento[] 

  @@map("registro_estado_animo")
}
