  id         Int     @id @default(autoincrement())
  solitario  Boolean @default(false)
  noQuerido  Boolean @default(false)
  noDeseado  Boolean @default(false)
  rechazado  Boolean @default(false)
  solo       Boolean @default(false)
  abandonado Boolean @default(false)

  porcentajeCreenciaAntes   Int
  porcentajeCreenciaDespues Int?

  registroEstadoAnimo   RegistroEstadoAnimo @relation(fields: [registroEstadoAnimoId], references: [id], onDelete: Cascade)
  registroEstadoAnimoId String              @unique

  @@map("grupoEmociones5")
}

model GrupoEmociones6 {
  id        Int     @id @default(autoincrement())
  turbado   Boolean @default(false)
  tonto     Boolean @default(false)
  humillado Boolean @default(false)
  apurado   Boolean @default(false)

  porcentajeCreenciaAntes   Int
  porcentajeCreenciaDespues Int?

  registroEstadoAnimo   RegistroEstadoAnimo @relation(fields: [registroEstadoAnimoId], references: [id], onDelete: Cascade)
  registroEstadoAnimoId String              @unique

  @@map("grupoEmociones6")
}

model GrupoEmociones7 {
  id             Int     @id @default(autoincrement())
  desesperanzado Boolean @default(false)
  desanimado     Boolean @default(false)
  pesimista      Boolean @default(false)
  descorazonado  Boolean @default(false)

  porcentajeCreenciaAntes   Int
  porcentajeCreenciaDespues Int?

  registroEstadoAnimo   RegistroEstadoAnimo @relation(fields: [registroEstadoAnimoId], references: [id], onDelete: Cascade)
  registroEstadoAnimoId String              @unique

