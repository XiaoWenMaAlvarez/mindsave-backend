  chasqueado Boolean @default(false)
  derrotado  Boolean @default(false)

  porcentajeCreenciaAntes   Int
  porcentajeCreenciaDespues Int?

  registroEstadoAnimo   RegistroEstadoAnimo @relation(fields: [registroEstadoAnimoId], references: [id], onDelete: Cascade)
  registroEstadoAnimoId String              @unique

  @@map("grupoEmociones8")
}

model GrupoEmociones9 {
  id          Int     @id @default(autoincrement())
  airado      Boolean @default(false)
  enfadado    Boolean @default(false)
  resentido   Boolean @default(false)
  molesto     Boolean @default(false)
  irritado    Boolean @default(false)
  trastornado Boolean @default(false)
  furioso     Boolean @default(false)

  porcentajeCreenciaAntes   Int
  porcentajeCreenciaDespues Int?

  registroEstadoAnimo   RegistroEstadoAnimo @relation(fields: [registroEstadoAnimoId], references: [id], onDelete: Cascade)
  registroEstadoAnimoId String              @unique

  @@map("grupoEmociones9")
}

model GrupoEmocionesPersonalizadas {
  id                        Int                    @id @default(autoincrement())
  listaEmociones            EmocionPersonalizada[]
  porcentajeCreenciaAntes   Int
  porcentajeCreenciaDespues Int?

  registroEstadoAnimo   RegistroEstadoAnimo @relation(fields: [registroEstadoAnimoId], references: [id], onDelete: Cascade)
  registroEstadoAnimoId String              @unique

  @@map("grupoEmocionesPersonalizadas")
}

model EmocionPersonalizada {
  id                             Int                          @id @default(autoincrement())
  descripcion                    String
  grupoEmocionesPersonalizadasId Int
  grupoEmocionesPersonalizadas   GrupoEmocionesPersonalizadas @relation(fields: [grupoEmocionesPersonalizadasId], references: [id], onDelete: Cascade)

  @@map("emocionPersonalizada")
}

model Distorsion {
  id                         Int         @id @default(autoincrement())
  pensamientoTodoONada       Boolean     @default(false)
  generalizacionExcesiva     Boolean     @default(false)
  filtroMental               Boolean     @default(false)
  descargarLoPositivo        Boolean     @default(false)
  saltarAConclusiones        Boolean     @default(false)
  magnificacionOMinimizacion Boolean     @default(false)
  razonamientoEmocional      Boolean     @default(false)
  afirmacionesDelTipoDeberia Boolean     @default(false)
  ponerEtiquetas             Boolean     @default(false)
  inculpacion                Boolean     @default(false)
  pensamiento                Pensamiento @relation(fields: [pensamientoId], references: [id], onDelete: Cascade)
  pensamientoId              Int         @unique

  @@map("distorsion")
}

model Pensamiento {
  id Int @id @default(autoincrement())

  pensamientoNegativo       String
  porcentajeCreenciaAntes   Int
  porcentajeCreenciaDespues Int?

  pensamientoPositivo        String?
  porcentajeCreenciaPositivo Int?

  distorsion Distorsion?

  registroEstadoAnimoId String
  registroEstadoAnimo   RegistroEstadoAnimo @relation(fields: [registroEstadoAnimoId], references: [id], onDelete: Cascade)

  @@map("pensamiento")
}

model RegistroEstadoAnimo {
  id                 String   @id @default(uuid())
  idUsuario          String
  user               User     @relation(fields: [idUsuario], references: [id],  onDelete: Cascade)
  fecha              DateTime @default(now())
  sucesoTrastornador String

  grupoEmociones1 GrupoEmociones1?

  grupoEmociones2 GrupoEmociones2?

  grupoEmociones3 GrupoEmociones3?

  grupoEmociones4 GrupoEmociones4?

  grupoEmociones5 GrupoEmociones5?

  grupoEmociones6 GrupoEmociones6?

  grupoEmociones7 GrupoEmociones7?

  grupoEmociones8 GrupoEmociones8?

  grupoEmociones9              GrupoEmociones9?
  grupoEmocionesPersonalizadas GrupoEmocionesPersonalizadas?

  pensamientos Pensamiento[]

  @@map("registro_estado_animo")
}


model Chat {
  id          String     @id @default(uuid())

  title      String

  idUsuario   String
  user        User     @relation(fields: [idUsuario], references: [id], onDelete: Cascade)
  
  mensajes   Mensaje[] 

	@@unique([idUsuario, title], map: "chat_idUsuario_title_key")
	@@map("chat")
}

enum TipoChatRol {
  model
  user
  system
}

model ChatRole {
  id          Int     @id @default(autoincrement())
  description TipoChatRol @unique
  mensajes   Mensaje[] 

  @@map("chat_role")
}

model Mensaje {
  id       String     @id @default(uuid())
  text   String
  createdAt DateTime @default(now())


  roleId Int
  role   ChatRole     @relation(fields: [roleId], references: [id])

  chatId String
  chat  Chat   @relation(fields: [chatId], references: [id], onDelete: Cascade)
  
  archivos   Archivo[] 
	@@map("mensaje")
}

model Archivo {
  id       String     @id @default(uuid())

  fileUri   String
  mimeType   String
  fileUrl   String

  mensajeId String
  mensaje  Mensaje   @relation(fields: [mensajeId], references: [id], onDelete: Cascade)
	@@map("archivo")
}
