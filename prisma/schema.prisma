// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TipoRol {
  PROFESIONAL_ROL
  USER_ROL
}

model Role {
  id          Int     @id @default(autoincrement())
  description TipoRol @unique
  users       User[]

  @@map("role")
}

model User {
  id                   String    @id @default(uuid())
  email                String    @unique
  name                 String
  emailVerified        Boolean   @default(false)
  password             String
  roleId               Int
  role                 Role      @relation(fields: [roleId], references: [id])
  isActive             Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  resetToken           String?
  resetTokenExpiration DateTime?

  testsBreveEstadoDeAnimo TestBreveEstadoDeAnimo[]
  registrosEstadoAnimo    RegistroEstadoAnimo[]
  chats                   Chat[]

  @@map("user")
}

model Depresion {
  id                    Int                     @id @default(autoincrement())
  tristeza              Int
  desesperanza          Int
  bajaAutoestima        Int
  faltaDeValor          Int
  perdidaDeSatisfaccion Int
  testBreve           TestBreveEstadoDeAnimo @relation(fields: [testBreveId], references: [id], onDelete: Cascade)
  testBreveId         String                           @unique

  @@map("depresion")
}

model ImpulsoSuicida {
  id                   Int                     @id @default(autoincrement())
  pensamientosSuicidas Int
  deseosDeMorir        Int
  testBreve            TestBreveEstadoDeAnimo @relation(fields: [testBreveId], references: [id], onDelete: Cascade)
  testBreveId      String                           @unique


  @@map("impulso_suicida")
}

model SentimientosAnsiedadFisica {
  id                      Int                     @id @default(autoincrement())
  palpitaciones           Int
  sudoracion              Int
  temblores               Int
  dificultadRespirar      Int
  ahogo                   Int
  dolorPecho              Int
  nauseas                 Int
  mareos                  Int
  sensacionIrrealidad     Int
  inestabilidadHormigueos Int
  testBreve               TestBreveEstadoDeAnimo @relation(fields: [testBreveId], references: [id], onDelete: Cascade)
  testBreveId    String                           @unique

  @@map("sentimientos_ansiedad_fisica")
}

model SentimientosAnsiedadEmocional {
  id         Int                     @id @default(autoincrement())
  angustiado Int
  nervioso   Int
  preocupado Int
  asustado   Int
  tenso      Int
  testBreve  TestBreveEstadoDeAnimo @relation(fields: [testBreveId], references: [id], onDelete: Cascade)
  testBreveId String                           @unique

  @@map("sentimientos_ansiedad_emocional")
}

model TestBreveEstadoDeAnimo {
  id                  String                        @id @default(uuid())
  depresion           Depresion?
  impulsoSuicida      ImpulsoSuicida?
  ansiedadFisica      SentimientosAnsiedadFisica?
  ansiedadEmocional   SentimientosAnsiedadEmocional?
  idUsuario           String
  user                User                          @relation(fields: [idUsuario], references: [id], onDelete: Cascade)
  fecha               DateTime                      @default(now())
  fechaDia            DateTime                      @db.Date
  notas               String?

  @@unique([idUsuario, fechaDia], map: "test_breve_estado_de_animo_idUsuario_fechaDia_key")
  @@map("test_breve_estado_de_animo")
}

model GrupoEmociones1 {
  id          Int     @id @default(autoincrement())
  triste      Boolean @default(false)
  melancolico Boolean @default(false)
  deprimido   Boolean @default(false)
  decaido     Boolean @default(false)
  infeliz     Boolean @default(false)

  porcentajeCreenciaAntes   Int
  porcentajeCreenciaDespues Int?

  registroEstadoAnimo   RegistroEstadoAnimo @relation(fields: [registroEstadoAnimoId], references: [id], onDelete: Cascade)
  registroEstadoAnimoId String              @unique

  @@map("grupoEmociones1")
}

model GrupoEmociones2 {
  id         Int     @id @default(autoincrement())
  angustiado Boolean @default(false)
  preocupado Boolean @default(false)
  conPanico  Boolean @default(false)
  nervioso   Boolean @default(false)
  asustado   Boolean @default(false)

  porcentajeCreenciaAntes   Int
  porcentajeCreenciaDespues Int?

  registroEstadoAnimo   RegistroEstadoAnimo @relation(fields: [registroEstadoAnimoId], references: [id], onDelete: Cascade)
  registroEstadoAnimoId String              @unique

  @@map("grupoEmociones2")
}

