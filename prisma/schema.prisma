  porcentajeCreenciaDespues Int?

  registroEstadoAnimo   RegistroEstadoAnimo @relation(fields: [registroEstadoAnimoId], references: [id], onDelete: Cascade)
  registroEstadoAnimoId String              @unique

  @@map("grupoEmociones4")
